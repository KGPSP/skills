{
  "_comment": "Merge into existing package.json — qa-architect blueprint (node-generic)",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d postgres",
    "db:test:down": "docker compose -f docker-compose.test.yml down -v"
  },
  "devDependencies": {
    "vitest": "^2.0.0",
    "vite-tsconfig-paths": "^5.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.0",
    "msw": "^2.0.0",
    "@testcontainers/postgresql": "^10.0.0",
    "@playwright/test": "^1.48.0"
  }
}
