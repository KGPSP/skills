{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "swarm-orchestrator breadcrumbs",
  "description": "Append-only audit trail for swarm runs. Each entry timestamped, actor-attributed, event-typed.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["ts", "actor", "event"],
    "properties": {
      "ts": {
        "type": "string",
        "format": "date-time",
        "description": "ISO 8601 UTC timestamp"
      },
      "actor": {
        "type": "string",
        "enum": ["parent", "planner", "generator", "evaluator", "yolo", "human", "pivot-trigger", "smoke-test-runner", "playwright-runner"],
        "description": "Kto wpisał breadcrumb"
      },
      "event": {
        "type": "string",
        "enum": [
          "init",
          "plan_completed",
          "contract_accepted",
          "iteration_verdict",
          "commit",
          "smoke_test_passed",
          "smoke_test_failed",
          "evidence_written",
          "pivot_accepted",
          "pivot_executed",
          "pivot_aborted",
          "gate_approved",
          "yolo_iter",
          "yolo_stopped",
          "fragile_override",
          "destructive_blocked"
        ]
      },
      "details": {
        "type": "object",
        "description": "Event-specific payload (gate, sprint, iter, reason, hash, etc.)"
      }
    }
  }
}
